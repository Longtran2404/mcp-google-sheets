{
  "name": "mcp-google-sheets-server",
  "version": "2.2.1",
  "description": "Official TaskKit MCP server for Google Sheets data, formatting, chart, and worksheet automation.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "mcp-google-sheets-server": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "clean": "tsc --build --clean",
    "test:syntax": "node --check dist/index.js",
    "test:smoke": "node test/mcp-stdio-smoke.mjs",
    "test": "npm run build && npm run test:syntax && npm run test:smoke",
    "prepublishOnly": "npm run clean && npm test",
    "rebuild": "npm run clean && npm run build"
  },
  "keywords": [
    "mcp",
    "google-sheets",
    "model-context-protocol",
    "cursor",
    "ai",
    "ai-agent",
    "taskkit",
    "taskkit-vn",
    "spreadsheets",
    "automation"
  ],
  "author": {
    "name": "Trần Minh Long",
    "url": "https://www.taskkit.vn/tran-minh-long"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Longtran2404/mcp-google-sheets.git"
  },
  "bugs": {
    "url": "https://github.com/Longtran2404/mcp-google-sheets/issues"
  },
  "homepage": "https://www.taskkit.vn/ma-nguon-mo",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "googleapis": "^178.0.0",
    "google-auth-library": "^10.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ]
}
